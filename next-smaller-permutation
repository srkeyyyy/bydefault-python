def reverse(a, start , end):
    while start <=end:
        a[start], a[end] = a[end],a[start]
        start+=1
        end-=1
        
    return


arr = input()
l = [int(c) for c in arr]
i =  len(l)-1

pivot = -1
while(True):
    if l[i-1] > l[i]:
        pivot = i-1
        break
    i-=1
if pivot == -1:
    print(-1)
else:
    i = len(l)-1
    for j in range(i,pivot,-1):
        if l[j] < l[pivot]:
            l[j],l[pivot] = l[pivot],l[j]
            break
        
    l[pivot+1:i+1] = sorted(l[pivot+1:i+1] , reverse=True)
    
    res = ""
    for item in l:
        res+=str(item)
    print(res)
